<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clientes</title>
</head>
<body> 
    <li><a href="/">Voltar</a></li>
    <br>
    <h1 style="text-align: center;">Nossos clientes!</h1>

    <!-- forEach dentro da tabela -->

    <table border="1">
        <tr>
            <th width="150px">Clientes</th>
            <th>CPF</th>
        </tr>
        <!-- ForEach -->
         <% clientes.forEach(cliente => { %>
         <tr>
            <td><%=cliente.nome %></td>
            <td><%=cliente.cpf %></td>
         </tr>
         <% }) %>
    </table>
   
</body>
</html>